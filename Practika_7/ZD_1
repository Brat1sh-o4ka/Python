prod = int(input("Введите Рейтинг продукта(1-10): "))

match prod:
    case 1 | 2 | 3 :
        reit = "Плохой продукт! 💩 Не рекомендую"
    case 4 | 5 | 6 :
        reit = "Средний продукт! 😎 Можно попробовать"
    case 7 | 8:
        reit = "Хороший Продукт! 🤔 Рекомендую"
    case 9 | 10:
        reit = "Отличный Продукт! 💯 Рекомендую"
    case _:
        reit = "Неверное число"

print(f"Рейтинг {prod} — {reit} ")
