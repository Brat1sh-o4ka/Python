pi = 3.14

def calculate_rectangle_area(width, height):
    return width * height 

def calculate_circle_area(radius):
    return pi * (radius**2) 

width, height = map(float, input("Введите стороны прямоугольнка: ").split())
pl = calculate_rectangle_area(width, height)

print("Площадь прямоугольника равна: ", pl)
radius = float(input("Введите радиус: "))
plK = calculate_circle_area(radius)

print("Площадь круга равна: ", plK)
