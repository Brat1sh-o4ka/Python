B5000, B2000, B1000, B500, B200, B100 = 5000, 2000, 1000, 500, 200, 100

def raschet_kupyur(summa):
    """Считает количество купюр каждого номинала."""
    k5000 = summ // B5000
    summ = summ % B5000
    k2000 = summ // B2000
    summ = summ % B2000
    k1000 = summa // B1000
    summ = summ % B1000
    k500 = summ // B500
    summ = summ % B500
    k200 = summ // B200
    summ = summ % B200
    k100 = summ // B100
    return k5000, k2000, k1000, k500, k200, k100

summ = int(input("Введите сумму для снятия (кратную 100): "))
k5000, k2000, k1000, k500, k200, k100 = raschet_kupyur(summ)

print("Банкомат выдаст:")
print(f"5000 руб.: {k5000} шт ")
print(f"2000 руб.: {k2000} шт ")
print(f"1000 руб.: {k1000} шт ")
print(f"500 руб.: {k500} шт ")
print(f"200 руб.: {k200} шт ")
print(f"100 руб.: {k100} шт ")
